<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>BetterTacticalDevicesHandling.Server</AssemblyName>
    <RootNamespace>BetterTacticalDevicesHandling.Server</RootNamespace>
    <ModAuthor>Dmnv</ModAuthor>
    <ModName>BetterTacticalDevicesHandling</ModName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="$(SptNugetVersion)" />
    <PackageReference Include="SPTushonka.DI" Version="$(SptNugetVersion)" />
    <PackageReference Include="SPTushonka.Server.Core" Version="$(SptNugetVersion)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <Target Name="DeployServer" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <PropertyGroup>
      <ServerDeployDir>$(ServerModsPath)\$(ModAuthor)-$(ModName)</ServerDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <ServerDeployFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ServerDeployFiles)" DestinationFiles="@(ServerDeployFiles->'$(ServerDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="High" Text="Server deployed: $(ServerDeployDir)" />
  </Target>

  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <DistDir>$(MSBuildProjectDirectory)\..\dist</DistDir>
      <Staging>$(DistDir)\staging</Staging>
    </PropertyGroup>
    <ItemGroup>
      <ServerReleaseFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ServerReleaseFiles)" DestinationFiles="@(ServerReleaseFiles->'$(Staging)\SPT_Runtime\user\mods\$(ModAuthor)-$(ModName)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(Staging)" DestinationFile="$(DistDir)\$(ModAuthor)-$(ModName)-$(Version).zip" Overwrite="true" />
    <Message Importance="High" Text="Release zip: $(DistDir)\$(ModAuthor)-$(ModName)-$(Version).zip" />
  </Target>
</Project>
